<!-- CloudHub 2.0 Deployment Configuration Template -->
<!-- Add this plugin configuration to your pom.xml <plugins> section -->

<plugin>
    <groupId>org.mule.tools.maven</groupId>
    <artifactId>mule-maven-plugin</artifactId>
    <version>${mule.maven.plugin.version}</version>
    <extensions>true</extensions>
    <configuration>
        <!-- CloudHub 2.0 Deployment Configuration -->
        <cloudhub2Deployment>
            <!-- Anypoint Platform URI -->
            <uri>https://anypoint.mulesoft.com</uri>
            
            <!-- Provider (MC for MuleSoft Cloud) -->
            <provider>MC</provider>
            
            <!-- Authentication -->
            <username>${cloudhub2.username}</username>
            <password>${cloudhub2.password}</password>
            
            <!-- Environment Configuration -->
            <environment>${cloudhub2.environment}</environment>
            <businessGroup>${cloudhub2.businessGroup}</businessGroup>
            
            <!-- Target Configuration -->
            <target>${cloudhub2.target}</target>
            
            <!-- Application Configuration -->
            <applicationName>${cloudhub2.applicationName}</applicationName>
            <muleVersion>${app.runtime}</muleVersion>
            
            <!-- Resource Allocation -->
            <replicas>${cloudhub2.replicas}</replicas>
            <vCores>${cloudhub2.vCores}</vCores>
            
            <!-- Optional: Application Properties -->
            <properties>
                <property>
                    <key>env</key>
                    <value>${cloudhub2.environment}</value>
                </property>
                <property>
                    <key>http.port</key>
                    <value>8081</value>
                </property>
                <!-- Add more properties as needed -->
            </properties>
            
            <!-- Optional: JVM Arguments -->
            <deploymentSettings>
                <http>
                    <inbound>
                        <lastMileSecurity>true</lastMileSecurity>
                    </inbound>
                </http>
                <runtime>
                    <params>
                        <param>-XX:+UseG1GC</param>
                        <param>-XX:+UseStringDeduplication</param>
                    </params>
                </runtime>
            </deploymentSettings>
            
            <!-- Optional: Monitoring Configuration -->
            <monitoring>
                <autoRestart>true</autoRestart>
                <loggingNgEnabled>true</loggingNgEnabled>
            </monitoring>
            
            <!-- Optional: Network Configuration -->
            <network>
                <!-- Configure if using VPC -->
                <!-- <vpc>vpc-12345678</vpc> -->
            </network>
            
        </cloudhub2Deployment>
    </configuration>
</plugin>

